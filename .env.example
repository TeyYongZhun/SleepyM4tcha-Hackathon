# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Which inbox the dashboard shows. These two interact -- setting BACKEND_API_URL
# turns the Gmail path OFF entirely, because the backend then owns the inbox:
#
#   BACKEND_API_URL          CLASSIFIER_API_URL        what you get
#   ----------------------   -----------------------   ---------------------------------
#   (empty)                  http://localhost:8000     your real Gmail + the ML model
#   http://localhost:8000    (ignored)                 the seeded 520-email demo inbox
#   (empty)                  (empty)                   your real Gmail + keyword rules
#
# The demo inbox is what the models were built for, so it is the better thing to
# present; real Gmail proves it reads a live mailbox. Real Gmail also needs the
# gmail.modify scope granted in Google Cloud Console.

BACKEND_API_URL=

# Where POST /classify lives (the FastAPI gateway). Only used on the Gmail path.
# Unset, or unreachable, and Gmail falls back to keyword rules rather than failing.
CLASSIFIER_API_URL=

# "AI Draft" switch next to Reply. With a key, Gemini writes the draft from the email; the
# email's text is sent to Google, only when you press Reply with the switch on. Without one,
# a rule-based draft is used. Get a key at https://aistudio.google.com/apikey
# GEMINI_MODEL is optional (default gemini-3.5-flash-lite, Google's cheapest current tier).
# (The TL;DR in the summary panel needs no key: it is written locally.)
GEMINI_API_KEY=
GEMINI_MODEL=

# "Try the demo" button: logs in as a fake user and browses public/dummy.
# Set to false to disable (e.g. on a production deployment).
ENABLE_DEMO=true

# The demo account's "Import data" button, which replaces the bundled sample inbox with
# a pair of zips, and its "Clear data" row (which empties the inbox; "Try demo data" brings
# the sample back and needs no storage). Locally they write to public/import and you need
# nothing here.
#
# A deployed app has a read-only filesystem, so it needs somewhere else to put them:
# attach a Blob store in the Vercel dashboard (Storage > Create > Blob) and this is set
# for you. Leave it empty and the import button reports that it has nowhere to write.
BLOB_READ_WRITE_TOKEN=
