# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Which inbox the dashboard shows. These two interact -- setting BACKEND_API_URL
# turns the Gmail path OFF entirely, because the backend then owns the inbox:
#
#   BACKEND_API_URL          CLASSIFIER_API_URL        what you get
#   ----------------------   -----------------------   ---------------------------------
#   (empty)                  http://localhost:8000     your real Gmail + the ML model
#   http://localhost:8000    (ignored)                 the seeded 520-email demo inbox
#   (empty)                  (empty)                   your real Gmail + keyword rules
#
# The demo inbox is what the models were built for, so it is the better thing to
# present; real Gmail proves it reads a live mailbox. Real Gmail also needs the
# gmail.readonly scope granted in Google Cloud Console.

BACKEND_API_URL=

# Where POST /classify lives (the FastAPI gateway). Only used on the Gmail path.
# Unset, or unreachable, and Gmail falls back to keyword rules rather than failing.
CLASSIFIER_API_URL=

# "Try the demo" button: logs in as a fake user and browses public/dummy.
# Set to false to disable (e.g. on a production deployment).
ENABLE_DEMO=true
